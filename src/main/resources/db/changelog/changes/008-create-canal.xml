<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="008-create-canal" author="hvs">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="canal"/></not>
        </preConditions>
        <createTable tableName="canal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="status_desc" type="VARCHAR(255)"/>
            <column name="nome" type="VARCHAR(255)"/>
            <column name="descricao" type="VARCHAR(255)"/>
            <column name="logotipo_url" type="VARCHAR(255)"/>
            <column name="site" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
