<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="006-create-episodio" author="hvs">
        <preConditions onFail="MARK_RAN">
            <not><tableExists tableName="episodio"/></not>
        </preConditions>
        <createTable tableName="episodio">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="uuid" type="VARCHAR(255)">
                <constraints unique="true"/>
            </column>
            <column name="status_desc" type="VARCHAR(255)"/>
            <column name="arquivo_id" type="BIGINT">
                <constraints foreignKeyName="fk_episodio_arquivo" references="arquivo(id)"/>
            </column>
            <column name="titulo" type="VARCHAR(255)"/>
            <column name="numero" type="BIGINT"/>
            <column name="temporada" type="BIGINT"/>
            <column name="capa_url" type="VARCHAR(255)"/>
            <column name="programa_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_episodio_programa" references="programa(id)"/>
            </column>
            <column name="parte" type="BIGINT"/>
            <column name="duracao" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="episodio" indexName="idx_episodio_programa">
            <column name="programa_id"/>
        </createIndex>
        <createIndex tableName="episodio" indexName="idx_episodio_arquivo">
            <column name="arquivo_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
