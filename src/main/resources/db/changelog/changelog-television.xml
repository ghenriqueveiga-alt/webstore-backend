<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.30.xsd">

    <changeSet id="criar-tabela-canal" author="hvs">
        <comment>Tabela do canal de TV</comment>
        <createTable tableName="canal">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="uuid" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status_desc" type="VARCHAR(50)"/>
            <column name="nome" type="VARCHAR(255)"/>
            <column name="descricao" type="VARCHAR(500)"/>
            <column name="logotipo_url" type="VARCHAR(500)"/>
            <column name="site" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="criar-tabela-genero" author="hvs">
        <comment>Tabela de gêneros de anime</comment>
        <createTable tableName="genero">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="uuid" type="VARCHAR(36)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="status_desc" type="VARCHAR(50)"/>
            <column name="nome" type="VARCHAR(255)"/>
            <column name="descricao" type="VARCHAR(500)"/>
        </createTable>
    </changeSet>

    <changeSet id="adicionar-colunas-programa" author="hvs">
        <comment>Novos campos na tabela programa para suporte a canal de anime</comment>
        <addColumn tableName="programa">
            <column name="sinopse" type="VARCHAR(2000)"/>
            <column name="classificacao_etaria_code" type="VARCHAR(2)"/>
            <column name="estudio" type="VARCHAR(255)"/>
            <column name="diretor" type="VARCHAR(255)"/>
            <column name="capa_url" type="VARCHAR(500)"/>
            <column name="temporada_original" type="VARCHAR(50)"/>
            <column name="rede_original" type="VARCHAR(255)"/>
            <column name="tipo_exibicao_code" type="VARCHAR(2)"/>
            <column name="titulo_alternativo" type="VARCHAR(255)"/>
            <column name="audio_idiomas" type="VARCHAR(255)"/>
            <column name="legendas_disponiveis" type="VARCHAR(255)"/>
            <column name="site_oficial" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="criar-tabela-programa-genero" author="hvs">
        <comment>Tabela de relacionamento programa-genero</comment>
        <createTable tableName="programa_genero">
            <column name="programa_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_programa_genero_programa" references="programa(id)"/>
            </column>
            <column name="genero_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_programa_genero_genero" references="genero(id)"/>
            </column>
        </createTable>
        <addPrimaryKey tableName="programa_genero" columnNames="programa_id,genero_id" constraintName="pk_programa_genero"/>
    </changeSet>

    <changeSet id="adicionar-colunas-bloco" author="hvs">
        <comment>Novos campos na tabela bloco para grade semanal</comment>
        <addColumn tableName="bloco">
            <column name="dia_semana_code" type="VARCHAR(2)"/>
            <column name="faixa_horario_code" type="VARCHAR(2)"/>
            <column name="tipo_bloco_code" type="VARCHAR(2)"/>
        </addColumn>
    </changeSet>

    <changeSet id="adicionar-colunas-grade" author="hvs">
        <comment>Novos campos na tabela grade para período de validade</comment>
        <addColumn tableName="grade">
            <column name="periodo_inicio" type="TIMESTAMP"/>
            <column name="periodo_fim" type="TIMESTAMP"/>
            <column name="grade_ativa" type="BOOLEAN"/>
        </addColumn>
    </changeSet>

    <changeSet id="adicionar-capa-episodio" author="hvs">
        <comment>Coluna de imagem do episódio</comment>
        <addColumn tableName="episodio">
            <column name="capa_url" type="VARCHAR(500)"/>
        </addColumn>
    </changeSet>

    <changeSet id="20260827-add-parta-coluna-episodio" author="ai-assistant">
        <comment>Coluna parte do episódio</comment>
        <addColumn tableName="episodio">
            <column name="parte" type="VARCHAR(100)" nullable="true"/>
        </addColumn>
    </changeSet>

    <changeSet id="adicionar-colunas-programa" author="hvs">
        <comment>Campos adicionais do programa (classificacao etaria, exibicao, etc)</comment>
        <addColumn tableName="programa">
            <column name="sinopse" type="TEXT"/>
            <column name="classificacao_etaria_code" type="VARCHAR(10)"/>
            <column name="estudio" type="VARCHAR(255)"/>
            <column name="diretor" type="VARCHAR(255)"/>
            <column name="capa_url" type="VARCHAR(500)"/>
            <column name="temporada_original" type="VARCHAR(255)"/>
            <column name="rede_original" type="VARCHAR(255)"/>
            <column name="tipo_exibicao_code" type="VARCHAR(10)"/>
            <column name="titulo_alternativo" type="VARCHAR(255)"/>
            <column name="audio_idiomas" type="VARCHAR(255)"/>
            <column name="legendas_disponiveis" type="VARCHAR(255)"/>
            <column name="site_oficial" type="VARCHAR(255)"/>
        </addColumn>
    </changeSet>

    <changeSet id="criar-tabela-ending-detectado" author="hvs">
        <comment>Tabela de endings detectados por episódio</comment>
        <createTable tableName="ending_detectado">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="uuid" type="VARCHAR(255)"/>
            <column name="status_desc" type="VARCHAR(255)"/>
            <column name="inicio" type="datetime(6)"/>
            <column name="duracao" type="datetime(6)"/>
            <column name="fim" type="datetime(6)"/>
            <column name="confianca" type="DOUBLE"/>
            <column name="detectado" type="BIT(1)"/>
            <column name="arquivo_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_ending_detectado_arquivo" references="arquivo(id)"/>
            </column>
            <column name="episodio_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_ending_detectado_episodio" references="episodio(id)"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="criar-tabela-propaganda-detectado" author="hvs">
        <comment>Tabela com a posição da propaganda (média do fim da opening com o início do ending) por episódio</comment>
        <createTable tableName="propaganda_detectado">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="uuid" type="VARCHAR(255)"/>
            <column name="status_desc" type="VARCHAR(255)"/>
            <column name="arquivo_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_propaganda_detectado_arquivo" references="arquivo(id)"/>
            </column>
            <column name="episodio_id" type="BIGINT">
                <constraints nullable="true" foreignKeyName="fk_propaganda_detectado_episodio" references="episodio(id)"/>
            </column>
            <column name="inicio" type="datetime(6)"/>
            <column name="duracao" type="datetime(6)"/>
            <column name="fim" type="datetime(6)"/>
            <column name="op_fim" type="datetime(6)"/>
            <column name="ed_inicio" type="datetime(6)"/>
            <column name="posicao_pct" type="DOUBLE"/>
            <column name="confianca" type="DOUBLE"/>
            <column name="detectado" type="BIT(1)"/>
        </createTable>
    </changeSet>

    <changeSet id="remover-unique-programa-bloco" author="hvs">
        <comment>Remove constraint unique de programa_id na tabela bloco para permitir multiplos blocos por programa</comment>
        <sql>ALTER TABLE bloco DROP FOREIGN KEY FK1wjmqyqk0yqgex0yco85ec2j2</sql>
        <sql>ALTER TABLE bloco DROP INDEX UK3kfigl2h1p4ckewnpajmmjrek</sql>
    </changeSet>

    <changeSet id="duplicar-blocos-demais-dias" author="hvs">
        <comment>Duplica os blocos de segunda-feira para terça, quarta, quinta, sexta, sábado e domingo</comment>
        <sql>
            INSERT INTO bloco (uuid, status_desc, programa_id, horario, grade_id, dia_semana_desc, faixa_horario_desc, tipo_bloco_desc)
            SELECT UUID(), status_desc, programa_id, horario, grade_id, dia_novo, faixa_horario_desc, tipo_bloco_desc
            FROM bloco
            CROSS JOIN (
                SELECT 'Terça-feira' AS dia_novo UNION ALL
                SELECT 'Quarta-feira' UNION ALL
                SELECT 'Quinta-feira' UNION ALL
                SELECT 'Sexta-feira' UNION ALL
                SELECT 'Sábado' UNION ALL
                SELECT 'Domingo'
            ) dias
            WHERE dia_semana_desc = 'Segunda-feira' AND status_desc = 'AT';
        </sql>
    </changeSet>

</databaseChangeLog>